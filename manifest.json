{
    "display_information": {
        "name": "ACM Slackbot"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": false,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false
        },
        "bot_user": {
            "display_name": "ACM Slackbot",
            "always_online": true
        },
        "slash_commands": [
            {
                "command": "/listpeople",
                "description": "Example sheets command.",
                "should_escape": false
            },
            {
                "command": "/ping",
                "description": "Determine current latency.",
                "should_escape": false
            },
            {
                "command": "/version",
                "description": "Displays slackbot version.",
                "should_escape": false
            },
            {
                "command": "/reminder",
                "description": "Schedules a reminder at specified time.",
                "usage_hint": "[24 hour] [weekday] [message]",
                "should_escape": true
            },
            {
                "command": "/cancelreminder",
                "description": "Lists options of reminders to delete.",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "user": [
                "users:read"
            ],
            "bot": [
                "users:read",
                "channels:history",
                "chat:write",
                "commands",
                "im:history"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "message.channels",
                "message.im"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": true,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}